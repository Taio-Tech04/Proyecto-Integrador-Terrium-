# Variables generales
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# ─── SUPABASE ─────────────────────────────────────────────────────
# Encontrás estos valores en: https://supabase.com/dashboard
# Tu proyecto → Settings → API
SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXXXX
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXXXX

# Connection string de Supabase:
# Tu proyecto → Settings → Database → Connection string → URI
# Reemplazá [PASSWORD] y XXXXXXXXXXXXXXXX con tus datos reales
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.XXXXXXXXXXXXXXXX.supabase.co:5432/postgres

# Base de datos PostgreSQL (LOCAL — alternativa a Supabase)
POSTGRES_USER=terrium
POSTGRES_PASSWORD=terrium_secret
POSTGRES_DB=terrium_main

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
AMQP_URL=amqp://terrium:terrium_secret@localhost:5672

# URLs de servicios (para API Gateway)
LISTINGS_URL=http://localhost:3001
VALUATIONS_URL=http://localhost:3002
ANALYTICS_URL=http://localhost:3003
NOTIFICATIONS_URL=http://localhost:3004
USERS_URL=http://localhost:3005

# API Gateway
GATEWAY_PORT=4000

# Servicio Users
# 👇 Con Supabase: usá SUPABASE_DB_URL (el mismo para todos)
# USERS_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.XXXXXXXX.supabase.co:5432/postgres
# 👇 Con Docker local:
USERS_DATABASE_URL=postgresql://terrium:terrium_secret@localhost:5432/terrium_users
USERS_PORT=3005

# Servicio Listings
LISTINGS_DATABASE_URL=postgresql://terrium:terrium_secret@localhost:5432/terrium_listings
LISTINGS_PORT=3001

# Servicio Valuations
VALUATIONS_DATABASE_URL=postgresql://terrium:terrium_secret@localhost:5432/terrium_valuations
VALUATIONS_PORT=3002

# Servicio Analytics
ANALYTICS_DATABASE_URL=postgresql://terrium:terrium_secret@localhost:5432/terrium_analytics
ANALYTICS_PORT=3003

# Servicio Notifications
NOTIFICATIONS_DATABASE_URL=postgresql://terrium:terrium_secret@localhost:5432/terrium_notifications
NOTIFICATIONS_PORT=3004

# Email (SMTP - usar Mailtrap para development)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=tu_usuario_mailtrap
SMTP_PASS=tu_password_mailtrap
FROM_EMAIL=noreply@terrium.ar

# MercadoPago (para suscripciones)
MP_ACCESS_TOKEN=tu_access_token_mercadopago
MP_PUBLIC_KEY=tu_public_key_mercadopago

# BCRA API (tipo de cambio)
BCRA_API_URL=https://api.bcra.gob.ar

# API de Datos Abiertos CABA (operaciones inmobiliarias)
# Portal: https://data.buenosaires.gob.ar
CABA_API_URL=https://data.buenosaires.gob.ar/api/3/action/datastore_search
CABA_RESOURCE_ID=e4bc6e71-7a0a-4a7b-8a36-0b82a5d9f42c
# CABA_API_KEY=tu_api_key_opcional

# Sync interval en minutos (solo para testing, dejar vacío en producción = corre a las 3AM)
# CABA_SYNC_INTERVAL_MIN=60

